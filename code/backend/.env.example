# Copy to .env; keep secrets out of version control. URL-encode passwords.
APP_ENV=development
# Normally use a separate restricted LOGIN role inheriting authenticated.
# Explicit development-only administrative access; never enable in production.
ALLOW_ADMIN_DATABASE_RUNTIME=false
DATABASE_URL=postgresql+psycopg://scheduler_runtime:REPLACE_ME@127.0.0.1:55432/scheduler_dev
# Used only by Alembic/admin commands, never by ordinary user sessions.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:REPLACE_ME@127.0.0.1:55432/scheduler_dev
# Required before using JWT-protected sessions (not for local connection check).
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_PUBLIC_KEY=REPLACE_PUBLISHABLE_OR_ANON_KEY
# Optional alternative to SUPABASE_PUBLIC_KEY: SUPABASE_ANON_KEY.
# Private Auth Admin lookup only, required for rejecting duplicate signup emails.
# Never used for registration/login/verify/resend, JWT verification or app CRUD.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_BACKEND_SECRET_OR_LEGACY_SERVICE_ROLE_KEY
# Optional comma-separated exact browser origins. No wildcard; no frontend code.
CORS_ORIGINS=
# Optional module packages, e.g. app.modules.example; share Base and Alembic.
BACKEND_MODULES=
# For a remote connection, use sslmode=verify-full and a trusted root certificate.
# Direct DB: db.PROJECT_REF.supabase.co:5432 (IPv6 unless IPv4 is enabled).
# Session pooler: copy the project's Session connection string (port 5432),
# substitute the restricted role's pooler username only if supported/verified.
# Transaction pooler :6543 is intentionally unsupported in this foundation.
