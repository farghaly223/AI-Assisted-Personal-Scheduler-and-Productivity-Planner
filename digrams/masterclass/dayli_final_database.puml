@startuml dayli_final_database
title DAYLI / Tempo — final database (0003 above deployed 0002_energy)
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam entity {
  BackgroundColor White
  BorderColor #425466
}
legend left
  PK = UUID primary key; FK = real foreign key
  * = NOT NULL; optional columns omit *
  Business ownership is shown by package.
  All app tables use profile ownership + RLS.
endlegend
package "Supabase Auth (external; unchanged)" #EEEEEE {
  entity "auth.users" as auth_users {
    * id : UUID <<PK>>
  }
}
package "User" #E8F4FC {
  entity "profiles" as profiles <<existing>> {
    * id : UUID <<PK, FK>>
    username : VARCHAR(100)
    full_name : VARCHAR(200)
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
  }
  entity "user_preferences" as user_preferences <<existing>> {
    * preference_id : UUID <<PK>>
    * user_id : UUID <<FK>>
    * timezone : VARCHAR(100)
    * notifications_enabled : BOOLEAN
    preferred_work_start : TIME(0) WITHOUT TIME ZONE
    preferred_work_end : TIME(0) WITHOUT TIME ZONE
    * updated_at : TIMESTAMPTZ
  }
  entity "availability_windows" as availability_windows <<new>> {
    * id : UUID <<PK>>
    * user_id : UUID <<FK>>
    * weekday : SMALLINT
    * start_time : TIME(0) WITHOUT TIME ZONE
    * end_time : TIME(0) WITHOUT TIME ZONE
    * timezone : VARCHAR(100)
    valid_from : DATE
    valid_until : DATE
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
  }
}
package "Scheduler" #E8F8ED {
  entity "tasks" as tasks <<existing>> {
    * task_id : UUID <<PK>>
    * user_id : UUID <<FK>>
    * title : VARCHAR(500)
    * task_type : VARCHAR(8)
    deadline : TIMESTAMPTZ
    * estimated_duration_minutes : INTEGER
    * category : VARCHAR(20)
    * priority : INTEGER
    fixed_start_at : TIMESTAMPTZ
    fixed_end_at : TIMESTAMPTZ
    * status : VARCHAR(20)
    context : VARCHAR(500)
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
  }
  entity "events" as events <<existing>> {
    * event_id : UUID <<PK>>
    * user_id : UUID <<FK>>
    * title : VARCHAR(500)
    location : VARCHAR(500)
    * category : VARCHAR(20)
    * recurrence_type : VARCHAR(6)
    start_at : TIMESTAMPTZ
    end_at : TIMESTAMPTZ
    recurrence_first_date : DATE
    recurrence_until_date : DATE
    recurrence_start_time : TIME(0) WITHOUT TIME ZONE
    recurrence_end_time : TIME(0) WITHOUT TIME ZONE
    recurrence_end_day_offset : SMALLINT
    recurrence_timezone : VARCHAR(100)
    * source : VARCHAR(20)
    * status : VARCHAR(20)
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
  }
  entity "task_requirements" as task_requirements <<new>> {
    * task_id : UUID <<PK, FK>>
    * user_id : UUID <<FK>>
    * can_split : BOOLEAN
    minimum_session_minutes : INTEGER
    preferred_start_time : TIME(0) WITHOUT TIME ZONE
    preferred_end_time : TIME(0) WITHOUT TIME ZONE
    preferred_timezone : VARCHAR(100)
    required_energy_level : VARCHAR(6)
    required_attention_level : VARCHAR(6)
    * updated_at : TIMESTAMPTZ
  }
  entity "task_outcomes" as task_outcomes <<new>> {
    * id : UUID <<PK>>
    * user_id : UUID <<FK>>
    task_id : UUID <<FK>>
    schedule_item_id : UUID <<FK>>
    * outcome : VARCHAR(9)
    * occurred_at : TIMESTAMPTZ
    * client_key : UUID
    * task_snapshot : JSONB
    note : VARCHAR(2000)
    * created_at : TIMESTAMPTZ
  }
  entity "schedules" as schedules <<new>> {
    * id : UUID <<PK>>
    * user_id : UUID <<FK>>
    current_version_id : UUID <<FK>>
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
  }
  entity "schedule_versions" as schedule_versions <<new>> {
    * id : UUID <<PK>>
    * user_id : UUID <<FK>>
    * schedule_id : UUID <<FK>>
    * version_number : INTEGER
    parent_version_id : UUID <<FK>>
    decision_execution_id : UUID <<FK>>
    * window_start_at : TIMESTAMPTZ
    * window_end_at : TIMESTAMPTZ
    * timezone : VARCHAR(100)
    * origin : VARCHAR(11)
    * status : VARCHAR(9)
    * input_snapshot : JSONB
    explanation : VARCHAR(4000)
    * created_at : TIMESTAMPTZ
    published_at : TIMESTAMPTZ
  }
  entity "schedule_items" as schedule_items <<new>> {
    * id : UUID <<PK>>
    * user_id : UUID <<FK>>
    * schedule_version_id : UUID <<FK>>
    * logical_key : UUID
    * kind : VARCHAR(5)
    task_id : UUID <<FK>>
    event_id : UUID <<FK>>
    event_occurrence_date : DATE
    label : VARCHAR(500)
    * start_at : TIMESTAMPTZ
    * end_at : TIMESTAMPTZ
    * is_locked : BOOLEAN
    * source_snapshot : JSONB
    * created_at : TIMESTAMPTZ
  }
  entity "unscheduled_tasks" as unscheduled_tasks <<new>> {
    * id : UUID <<PK>>
    * user_id : UUID <<FK>>
    * schedule_version_id : UUID <<FK>>
    task_id : UUID <<FK>>
    * reason_code : VARCHAR(100)
    explanation : VARCHAR(2000)
    * task_snapshot : JSONB
    * created_at : TIMESTAMPTZ
  }
  entity "schedule_validation_issues" as schedule_validation_issues <<new>> {
    * id : UUID <<PK>>
    * user_id : UUID <<FK>>
    * schedule_version_id : UUID <<FK>>
    item_id : UUID <<FK>>
    related_item_id : UUID <<FK>>
    * severity : VARCHAR(7)
    * code : VARCHAR(100)
    * message : VARCHAR(2000)
    * details : JSONB
    * created_at : TIMESTAMPTZ
  }
}
package "Energy" #FFF4E6 {
